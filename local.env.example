# Copy this file to local.env and replace the values with paths on your machine.
# local.env is ignored by Git and must never be published.

# EU4 installation directory containing eu4.exe.
EU4_GAME_ROOT=C:\path\to\Europa Universalis IV

# EU4 user-data directory containing mod, dlc_load.json, logs, and save games.
EU4_USER_DATA=C:\path\to\Paradox Interactive\Europa Universalis IV

# Python executable for the project's Windows helper scripts.
EU4_PYTHON=C:\path\to\python.exe

# Native build and offline-analysis tools.
EU4_CXX=C:\path\to\g++.exe
EU4_OBJDUMP=C:\path\to\objdump.exe

# Optional: a minidump used by work/analyze_native_crash.py.
# EU4_CRASH_DUMP=C:\path\to\minidump.dmp
